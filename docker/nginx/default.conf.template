server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;

    root  /var/www/html/public;
    index index.php;

    charset utf-8;

    # Evidence uploads (POD photos, scanned documents, receipts) are capped by
    # the application at 10 MB by default. Keep nginx just above that ceiling so
    # oversized requests still reach Laravel's validation instead of a 413.
    client_max_body_size 12m;

    # Render health check.
    location = /up {
        access_log off;
        try_files $uri /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass  127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_read_timeout 120s;
        include       fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO       $fastcgi_path_info;
    }

    # Long-lived caching for Vite's fingerprinted assets.
    location ~* \.(?:css|js|mjs|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|ico|webp|avif)$ {
        expires    1y;
        access_log off;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
